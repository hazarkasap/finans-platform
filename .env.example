# Copy to .env for local development and replace every placeholder.
NODE_ENV=development
DATABASE_URL=postgresql://demo_user:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/finance_showcase
AUTH_URL=http://127.0.0.1:3000
AUTH_SECRET=REPLACE_WITH_OUTPUT_FROM_OPENSSL_RAND_BASE64_32

# Optional API-only local demonstration bypass. Keep false unless intentionally testing curl flows.
ALLOW_DEMO_AUTH=false

# Compose database initialization. Values are required; no deployable defaults are provided.
POSTGRES_USER=demo_user
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
POSTGRES_DB=finance_showcase
